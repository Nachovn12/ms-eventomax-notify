SERVER_PORT=8080

# PostgreSQL / Flyway
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/postgres?currentSchema=notify
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
FLYWAY_ENABLED=true
SPRING_FLYWAY_DEFAULT_SCHEMA=notify
SPRING_FLYWAY_SCHEMAS=notify
SPRING_FLYWAY_CREATE_SCHEMAS=true
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=notify

# RabbitMQ Cluster (2 nodos en eventomax-net)
SPRING_RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=<RABBITMQ_USER>
RABBITMQ_PASSWORD=<RABBITMQ_PASSWORD>

# Integración interna y proveedores de notificación
CATALOG_BASE_URL=http://ms-eventomax-catalog:8080
# Modo académico de simulación: logging (por defecto) | Modo SMTP real/Mailpit: smtp
EVENTOMAX_NOTIFY_EMAIL_PROVIDER=logging
EVENTOMAX_NOTIFY_CREW_PROVIDER=database
EVENTOMAX_NOTIFY_QUOTE_PROVIDER=enterprise

# Configuración SMTP (usada cuando EVENTOMAX_NOTIFY_EMAIL_PROVIDER=smtp)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_TIMEOUT_MS=5000
NOTIFY_MAIL_FROM=no-reply@eventomax.cl
NOTIFY_MAIL_FROM_NAME=EventoMax Notificaciones

# Persistencia de actas PDF y reintentos
STORAGE_PROVIDER=local
NOTIFY_QUOTE_OUTPUT_DIR=/data/quotes
STORAGE_LOCAL_BASE_DIR=/data/quotes
NOTIFY_RETRY_MAX_ATTEMPTS=3
NOTIFY_RETRY_INITIAL_INTERVAL_MS=500
